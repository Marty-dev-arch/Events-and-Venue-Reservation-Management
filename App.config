<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!-- SQL Server / SSMS Connection String (Windows Authentication) -->
		<!-- If using SQL Server Express, change Server=localhost to Server=localhost\SQLEXPRESS -->
		<add name="SqlServerConnection"
			 connectionString="Server=localhost\SQLEXPRESS;Database=events_and_venue_reservation;Trusted_Connection=True;TrustServerCertificate=True;"
			 providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>
</configuration>
